{
  "name": "nextjs",
  "version": "7.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "node scripts/stop-dev.mjs && next dev --webpack",
    "dev:restart": "node scripts/stop-dev.mjs && next dev --webpack",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --coverage && node scripts/verify-security.mjs",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run lint && npm run typecheck && npm run test:all && npm run knip:dependencies",
    "knip": "knip",
    "knip:dependencies": "knip --dependencies",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:obtainium": "node scripts/verify-obtainium-readiness.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify:v7": "npm run quality && npm run build && npm run test:e2e && npm --prefix expo run quality && npm --prefix expo run doctor && npm run expo:ios:ready && npm run expo:ios:bundle:check && npm --prefix expo run android:bundle:check",
    "test:import-images": "node scripts/verify-import-images.mjs",
    "sync:web-favicons": "node scripts/sync-web-favicons.mjs",
    "seed:demo-account": "node scripts/seed-demo-account.mjs",
    "expo:start": "npm --prefix expo run start",
    "expo:android": "npm --prefix expo run android",
    "expo:ios": "npm --prefix expo run ios",
    "expo:ios:config": "npm --prefix expo run ios:config",
    "expo:ios:ready": "npm --prefix expo run ios:ready",
    "expo:ios:bundle:check": "npm --prefix expo run ios:bundle:check",
    "expo:typecheck": "npm --prefix expo run typecheck",
    "expo:eas:init": "npm --prefix expo run eas:init",
    "expo:eas:preview": "npm --prefix expo run eas:build:preview",
    "eas:init": "npm --prefix expo run eas:init",
    "eas:build:preview": "npm --prefix expo run eas:build:preview",
    "eas:build:ios:preview": "npm --prefix expo run eas:build:ios:preview",
    "eas:build:ios:unsigned": "npm --prefix expo run eas:build:ios:unsigned",
    "eas:build:ios:production": "npm --prefix expo run eas:build:ios:production",
    "eas:env:push": "npm --prefix expo run eas:env:push",
    "eas:build:preview:nowait": "npm --prefix expo run eas:build:preview:nowait"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "7.83.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.1.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.2.12",
    "knip": "^6.29.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
