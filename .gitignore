# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
expo/coverage/
tests/e2e/*-snapshots/
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
/mcps
.DS_Store
*.pem

# debug
/terminals/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env*
!.env.example
!expo/.env.production.example

# vercel
.vercel
.env.vercel.*

# agent/debug scratch scripts
scripts/_tmp-*.mjs

# local Codex plugins and marketplace cache
/.agents/plugins/
/.codex-plugins/

# local UI research recordings (large, not runtime assets)
expo/assets/reference/

# supabase cli
supabase/.temp/

# windows shell accident
$null

# typescript
*.tsbuildinfo
next-env.d.ts

# signing secrets
*.keystore
*.jks
keystore.properties

# expo native prebuild output
/.expo/
expo/.expo/
expo/node_modules/
artifacts/
claude.md
.supabase-staging/
