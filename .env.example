# Required (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required on server only (register API, public playgroup)
SUPABASE_SERVICE_ROLE_KEY=

# Required for Turnstile captcha (client + server)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required for auth emails (signup confirmation + password reset via Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MTG Commander <noreply@your-domain.com>

# Public site URL used in auth email links (set per Dokploy environment)
NEXT_PUBLIC_SITE_URL=

# Platform admin (must also exist in platform_admin_emails table)
PLATFORM_ADMIN_EMAILS=
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# Public support/contact email shown in legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@phyrexianarena.dpdns.org

# Optional Sentry observability. Keep auth token server/build-only.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://sentry.io/
